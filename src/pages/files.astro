---
import BaseLayout from '../layouts/BaseLayout.astro';
import { promises as fs } from 'node:fs';
import path from 'node:path';

const dir = (process.env.UPLOADS_DIR ?? './data/uploads');
let files: { name: string; size: number; mtime: string }[] = [];
try {
  const names = await fs.readdir(dir);
  files = await Promise.all(
    names.filter((n) => !n.startsWith('.')).map(async (n) => {
      const st = await fs.stat(path.join(dir, n));
      return { name: n, size: st.size, mtime: st.mtime.toISOString() };
    })
  );
  files.sort((a, b) => (a.mtime < b.mtime ? 1 : -1));
} catch {}
---
<BaseLayout>
  <h2>Files</h2>
  <form method="post" action="/api/files" enctype="multipart/form-data" id="upload">
    <input type="file" name="file" required />
    <button type="submit">Upload</button>
  </form>
  <table>
    <thead><tr><th>Name</th><th>Size</th><th>Modified</th></tr></thead>
    <tbody>
      {files.map((f) => (
        <tr>
          <td><a href={`/api/files/${f.name}`} target="_blank" rel="noopener">{f.name}</a></td>
          <td>{f.size}b</td>
          <td>{f.mtime}</td>
        </tr>
      ))}
      {files.length === 0 && <tr><td colspan="3"><em>No files yet.</em></td></tr>}
    </tbody>
  </table>
  <script is:inline>
    document.getElementById('upload')?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const f = ev.target;
      const fd = new FormData(f);
      const res = await fetch('/api/files', { method: 'POST', body: fd });
      if (res.ok) location.reload();
    });
  </script>
</BaseLayout>
